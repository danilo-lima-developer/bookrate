@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<style>
    body, html {
        height: 100%;
        margin: 0;
        padding: 0;
        background: linear-gradient( 90deg, rgba(0, 0, 0, 1) 0%, /* Preto puro (esquerda) */
        rgba(20, 20, 20, 1) 25%, /* Cinza muito escuro */
        rgba(50, 50, 50, 1) 50%, /* Cinza médio (centro) */
        rgba(20, 20, 20, 1) 75%, /* Cinza muito escuro (espelhado) */
        rgba(0, 0, 0, 1) 100% /* Preto puro (direita) */
        );
        background-attachment: fixed;
        background-size: cover;
    }
</style>